{
  "openapi": "3.1.0",
  "info": {
    "version": "1.0.0",
    "title": "Flats app",
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "description": "This is a documentation of flats app"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    },
    {
      "url": "https://flats-2.onrender.com"
    }
  ],
  "tags": [
    {
      "name": "Flats",
      "description": "Operations about flats."
    }
  ],
  "paths": {
    "/flats": {
      "get": {
        "tags": [
          "Flats"
        ],
        "summary": "Get list of flats",
        "operationId": "getFlats",
        "description": "Get list of flats",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer"
            },
            "example": 1
          },
          {
            "in": "query",
            "name": "perPage",
            "schema": {
              "type": "integer",
              "example": 10
            }
          },
          {
            "in": "query",
            "name": "sortBy",
            "schema": {
              "type": "string",
              "example": "rooms"
            },
            "description": "All flat's fields can be mentioned. Default value - _id"
          },
          {
            "in": "query",
            "name": "sortOrder",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "example": "asc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully found flats!",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully found flats!"
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "data",
                        "page",
                        "perPage",
                        "totalItems",
                        "totalPages",
                        "hasNextPage",
                        "hasPreviousPage"
                      ],
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/flat"
                          }
                        },
                        "page": {
                          "type": "number",
                          "example": 2
                        },
                        "perPage": {
                          "type": "number",
                          "example": 4
                        },
                        "totalItems": {
                          "type": "number",
                          "example": 4
                        },
                        "totalPages": {
                          "type": "number",
                          "example": 4
                        },
                        "hasNextPage": {
                          "type": "boolean",
                          "example": false
                        },
                        "hasPreviousPage": {
                          "type": "boolean",
                          "example": true
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/404"
          }
        }
      },
      "post": {
        "tags": [
          "Flats"
        ],
        "summary": "Create flat",
        "operationId": "createFlat",
        "description": "Create a flat with payload",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "title",
                  "description",
                  "price",
                  "rooms",
                  "photos"
                ],
                "properties": {
                  "_id": {
                    "description": "Flat's id",
                    "type": "string",
                    "example": "65e4decdd286b30065d54af9"
                  },
                  "title": {
                    "description": "Flat's title",
                    "type": "string",
                    "example": "Comforn flat"
                  },
                  "description": {
                    "description": "Flat's description",
                    "type": "string",
                    "example": "Comfort place"
                  },
                  "rooms": {
                    "description": "Flat's rooms",
                    "type": "number",
                    "enum": [
                      1,
                      2,
                      3
                    ]
                  },
                  "price": {
                    "description": "Flat's price",
                    "type": "number",
                    "example": 1000
                  },
                  "photos": {
                    "description": "Link to flat's photos",
                    "type": "array",
                    "example": [
                      "https://res.cloudinary.com/image/upload/flat.png",
                      "https://res.cloudinary.com/image/upload/flat.png"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Creates a flat",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 201
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully created a flat!"
                    },
                    "data": {
                      "type": "object",
                      "$ref": "#/components/schemas/flat"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/404"
          }
        }
      }
    },
    "/flats/{id}": {
      "get": {
        "tags": [
          "Flats"
        ],
        "summary": "Get flat by id",
        "operationId": "getFlatById",
        "description": "Get flat by id",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "example": "66ca67e7ae7f10c88b598384"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Get flat by id",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully found flat with id 66ca67e7ae7f10c88b598384!"
                    },
                    "data": {
                      "type": "object",
                      "$ref": "#/components/schemas/flat"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/404"
          }
        }
      },
      "patch": {
        "tags": [
          "Flats"
        ],
        "summary": "Patch flat by id",
        "operationId": "patchFlat",
        "description": "Patch flat by id",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "example": "66ca67e7ae7f10c88b598384"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "title",
                  "description",
                  "price",
                  "rooms",
                  "photos"
                ],
                "properties": {
                  "_id": {
                    "description": "Flat's id",
                    "type": "string",
                    "example": "65e4decdd286b30065d54af9"
                  },
                  "title": {
                    "description": "Flat's title",
                    "type": "string",
                    "example": "Comforn flat"
                  },
                  "description": {
                    "description": "Flat's description",
                    "type": "string",
                    "example": "Comfort place"
                  },
                  "rooms": {
                    "description": "Flat's rooms",
                    "type": "number",
                    "enum": [
                      1,
                      2,
                      3
                    ]
                  },
                  "price": {
                    "description": "Flat's price",
                    "type": "number",
                    "example": 1000
                  },
                  "photos": {
                    "description": "Link to flat's photos",
                    "type": "array",
                    "example": [
                      "https://res.cloudinary.com/image/upload/flat.png",
                      "https://res.cloudinary.com/image/upload/flat.png"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Patch flat by id",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully patched flat with id 66ca67e7ae7f10c88b598384!"
                    },
                    "data": {
                      "type": "object",
                      "$ref": "#/components/schemas/flat"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/404"
          }
        }
      },
      "delete": {
        "tags": [
          "Flats"
        ],
        "summary": "Delete flat by id",
        "operationId": "deleteFlat",
        "description": "Delete flat by id",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "example": "65ca67e7ae7f10c88b598384"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted flat by id"
          },
          "404": {
            "$ref": "#/components/responses/404"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "flat": {
        "type": "object",
        "required": [
          "_id",
          "title",
          "rooms",
          "price",
          "description"
        ],
        "properties": {
          "_id": {
            "description": "Flat's id",
            "type": "string",
            "example": "65e4decdd286b30065d54af9"
          },
          "title": {
            "description": "Flat's title",
            "type": "string",
            "example": "Comforn flat"
          },
          "description": {
            "description": "Flat's description",
            "type": "string",
            "example": "Comfort place"
          },
          "rooms": {
            "description": "Flat's rooms",
            "type": "number",
            "enum": [
              1,
              2,
              3
            ]
          },
          "price": {
            "description": "Flat's price",
            "type": "number",
            "example": 1000
          },
          "photos": {
            "description": "Link to flat's photo",
            "type": "array",
            "example": [
              "https://res.cloudinary.com/image/upload/flat.png",
              "https://res.cloudinary.com/image/upload/flat.png"
            ]
          }
        }
      }
    },
    "responses": {
      "404": {
        "description": "Page not found error",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "status",
                "message",
                "data"
              ],
              "properties": {
                "status": {
                  "type": "integer",
                  "example": 404
                },
                "message": {
                  "type": "string",
                  "example": "notFoundError"
                },
                "data": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Page not found"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}